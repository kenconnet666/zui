{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install:*)",
      "Bash(pnpm i)",
      "Bash(pnpm i:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm changeset)",
      "Bash(pnpm changeset:*)",
      "Bash(pnpm dev)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build)",
      "Bash(pnpm build:*)",
      "Bash(pnpm bench)",
      "Bash(pnpm bench:*)",
      "Bash(node scripts/generate-properties.mjs)",
      "Bash(node scripts/*)",
      "Bash(node -e:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git tag --list:*)",
      "Bash(git stash list)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git pull:*)",
      "Bash(git push origin main)",
      "Bash(git push origin v*)",
      "Bash(npm view:*)",
      "Bash(npm whoami)",
      "Bash(npm config get:*)",
      "Bash(npm ls:*)",
      "Bash(npm pack --dry-run:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(awk:*)",
      "mcp__jetbrain__get_file_problems",
      "mcp__jetbrain__get_file_text_by_path",
      "mcp__jetbrain__read_file",
      "mcp__jetbrain__list_directory_tree",
      "mcp__jetbrain__find_files_by_glob",
      "mcp__jetbrain__find_files_by_name_keyword",
      "mcp__jetbrain__search_in_files_by_regex",
      "mcp__jetbrain__search_in_files_by_text",
      "mcp__jetbrain__search_symbol",
      "mcp__jetbrain__search_regex",
      "mcp__jetbrain__search_text",
      "mcp__jetbrain__search_file",
      "mcp__jetbrain__get_symbol_info",
      "mcp__jetbrain__get_all_open_file_paths",
      "mcp__jetbrain__get_project_dependencies",
      "mcp__jetbrain__get_project_modules",
      "mcp__jetbrain__get_repositories",
      "mcp__jetbrain__get_run_configurations",
      "mcp__jetbrain__generate_psi_tree",
      "mcp__jetbrain__open_file_in_editor",
      "mcp__jetbrain__reformat_file",
      "LSP"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git branch -D:*)",
      "Bash(git commit --amend:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(Remove-Item -Recurse -Force:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(npm adduser:*)",
      "Bash(npm login:*)",
      "Bash(npm logout:*)",
      "Bash(npm token:*)",
      "Bash(npm config set //registry.npmjs.org/:_authToken:*)",
      "Bash(git config:*)",
      "Edit(.gitconfig)",
      "Edit(**/.npmrc)",
      "Write(.gitconfig)",
      "Write(**/.npmrc)"
    ]
  },
  "env": {
    "FORCE_COLOR": "1",
    "CI": "0"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const f=process.argv[1]||''; if(/\\.(ts|tsx|mjs|cjs|js|jsx|vue)$/.test(f)){console.error('[hint] '+f+' 改完，记得调用 mcp__jetbrain__get_file_problems 跑诊断')}\" \"$CLAUDE_FILE_PATH\""
          }
        ]
      }
    ]
  },
  "lsp": {
    "servers": {
      "typescript": {
        "command": "pnpm",
        "args": ["dlx", "typescript-language-server", "--stdio"],
        "filetypes": ["typescript", "typescriptreact", "javascript", "javascriptreact"],
        "rootPatterns": ["tsconfig.json", "package.json", "pnpm-workspace.yaml"]
      },
      "vue": {
        "command": "pnpm",
        "args": ["dlx", "@vue/language-server", "--stdio"],
        "filetypes": ["vue"],
        "rootPatterns": ["tsconfig.json", "package.json"]
      }
    }
  },
  "projectMemory": {
    "files": [
      ".claude/AGENT.md",
      ".claude/Plan.md",
      "packages/core/README.md",
      "packages/core/CHANGELOG.md"
    ]
  }
}

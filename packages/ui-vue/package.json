{
  "name": "@kenconnet666/zui-vue",
  "version": "0.10.2",
  "description": "Vue 3 components & helpers built on @kenconnet666/zui-core. ZBox for nested theme / componentTokens / locale / timezone, plus headless composables.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "publish": "pnpm publish --registry=https://registry.npmjs.org/ --access public --no-git-checks",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run type-check && pnpm run test && pnpm run build"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "css-in-js",
    "emotion",
    "design-system",
    "i18n",
    "timezone",
    "type-safe"
  ],
  "author": "kenconnet666 <kenconnet@foxmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/kenconnet666/zui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/zui.git",
    "directory": "packages/ui-vue"
  },
  "bugs": {
    "url": "https://github.com/kenconnet666/zui/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@emotion/css": "^11.13.5",
    "qrcode": "^1.5.4",
    "shiki": "^3.23.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "qrcode": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "dependencies": {
    "@emotion/unitless": "^0.10.0",
    "@floating-ui/vue": "^1.1.11",
    "@kenconnet666/zui-core": "workspace:*",
    "@vicons/material": "^0.13.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "async-validator": "^4.2.5",
    "color2k": "^2.0.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0"
  },
  "devDependencies": {
    "@emotion/css": "^11.13.5",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.4",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.9.0",
    "qrcode": "^1.5.4",
    "shiki": "^3.23.0",
    "vue": "^3.5.32"
  },
  "publishConfig": {
    "access": "public"
  }
}

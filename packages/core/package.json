{
  "name": "@kenconnet666/zui-core",
  "version": "0.5.0",
  "description": "Framework-agnostic CSS-in-JS toolkit. Class-generic theme system on top of @emotion/css with strongly-typed four-state property carriers (fn / token / keyword / unit).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "recipes",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/preset/animations.js",
    "**/preset/animations.mjs"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "type-check": "tsc -p tsconfig.typecheck.json",
    "prepublishOnly": "pnpm run type-check && pnpm run test && pnpm run build"
  },
  "keywords": [
    "css-in-js",
    "emotion",
    "typescript",
    "design-tokens",
    "theme",
    "type-safe",
    "framework-agnostic",
    "chain",
    "dsl"
  ],
  "author": "kenconnet666 <kenconnet@foxmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/kenconnet666/zui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/zui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/kenconnet666/zui/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@emotion/css": "^11.13.0"
  },
  "dependencies": {
    "color2k": "^2.0.3",
    "csstype": "^3.1.3"
  },
  "devDependencies": {
    "@emotion/css": "^11.13.5",
    "expect-type": "^1.1.0",
    "happy-dom": "^15.11.7"
  },
  "publishConfig": {
    "access": "public"
  }
}

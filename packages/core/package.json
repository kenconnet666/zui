{
  "name": "@kenconnet666/zui-core",
  "version": "0.0.1",
  "description": "Framework-agnostic CSS-in-JS toolkit (class-generic theme system on top of @emotion/css).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@emotion/css": "^11.13.0"
  },
  "dependencies": {
    "csstype": "^3.1.3"
  },
  "devDependencies": {
    "@emotion/css": "^11.13.5",
    "expect-type": "^1.1.0",
    "happy-dom": "^15.11.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
